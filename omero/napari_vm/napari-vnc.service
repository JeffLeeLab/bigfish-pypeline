[Unit]
Description=Napari VNC and noVNC stack (user service)
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/Github/bigfish-pypeline/omero/napari_vm
Environment=DISPLAY_NUM=21
Environment=DISPLAY_MIN=21
Environment=DISPLAY_MAX=29
Environment=ALLOW_DISPLAY_FALLBACK=1
Environment=NOVNC_PORT=16080
Environment=GEOMETRY=1920x1080
Environment=NOVNC_WEB_ROOT=/usr/share/novnc
Environment=PREFERRED_SESSION=minimal
Environment=WEBSOCKIFY_HEARTBEAT=30
Environment=WEBSOCKIFY_IDLE_TIMEOUT=0
Environment=AUTO_START_NAPARI=1
ExecStart=/usr/bin/env bash %h/Github/bigfish-pypeline/omero/napari_vm/start-napari-vnc-stack.sh
Restart=on-failure
RestartSec=3
Nice=10
CPUQuota=150%
TasksMax=512

[Install]
WantedBy=default.target
